# Secrets for Kamal, read from local files that are never committed.
# Never put raw secret values in this file.

RAILS_MASTER_KEY=$(cat config/master.key)

# GitHub token (classic, write:packages) for ghcr.io, in .kamal/registry_token (gitignored).
KAMAL_REGISTRY_PASSWORD=$(cat .kamal/registry_token)

# Staging Postgres password: generated once into .kamal/db_password (gitignored).
CONVOY_V3_DATABASE_PASSWORD=$(cat .kamal/db_password)
POSTGRES_PASSWORD=$CONVOY_V3_DATABASE_PASSWORD

# Shared secret between the Rails app and the routing service: generated once into .kamal/routing_secret (gitignored).
ROUTING_SECRET=$(cat .kamal/routing_secret)
